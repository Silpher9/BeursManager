# Lokale demo/test key voor artworkgeneratie via fal.ai.
# Let op: EXPO_PUBLIC_ waarden zijn zichtbaar in de lokale clientbundle.
# Gebruik dit alleen voor development en testdata.
EXPO_PUBLIC_FAL_KEY=fal_...

# Receipt-server configuratie voor bonnetje-scannen.
# URL naar de draaiende receipt-server instance.
EXPO_PUBLIC_RECEIPT_SERVER_URL=http://localhost:3001
# Shared secret token (moet overeenkomen met RECEIPT_AUTH_TOKEN in receipt-server/.env)
EXPO_PUBLIC_RECEIPT_TOKEN=een-random-token
